<Window x:Class="Ditto.Views.SnippetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snippet" Height="470" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="New Snippet" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,14" />

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,6">
            <TextBlock Text="Content" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                       DockPanel.Dock="Left" />
            <TextBlock x:Name="CharCount" Text="0 characters" FontSize="11"
                       Foreground="{StaticResource Secondary}" DockPanel.Dock="Right" />
        </DockPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource Hairline}"
                BorderThickness="1" Height="150">
            <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Padding="6"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="ContentBox_TextChanged" />
        </Border>

        <TextBlock Grid.Row="3" Text="Name (optional)" FontWeight="SemiBold"
                   Foreground="{StaticResource Secondary}" Margin="0,14,0,6" />
        <TextBox x:Name="NameBox" Grid.Row="4" Padding="6" Height="30"
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="Category" FontWeight="SemiBold"
                       Foreground="{StaticResource Secondary}" Margin="0,0,0,6" />
            <ComboBox x:Name="CategoryCombo" Height="30" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" MinWidth="80" Padding="10,6" Margin="0,0,8,0" IsCancel="True"
                    Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="Add" MinWidth="80" Padding="10,6" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
