<Window x:Class="Ditto.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ditto.ViewModels"
        xmlns:models="clr-namespace:Ditto.Models"
        Title="Ditto" Height="640" Width="980" MinWidth="720" MinHeight="460"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- A snippet card. Click copies; right-click opens the context menu;
             drag reorders or refiles. -->
        <DataTemplate x:Key="SnippetCardTemplate" DataType="{x:Type models:Snippet}">
            <Border x:Name="card"
                    Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    MinHeight="110" Margin="0,0,16,16" CornerRadius="16"
                    Background="{Binding CardBackgroundBrush}"
                    BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="Card_Click"
                    PreviewMouseLeftButtonDown="Card_MouseDown"
                    MouseMove="Card_MouseMove"
                    AllowDrop="True" DragOver="Card_DragOver" Drop="Card_Drop"
                    ToolTip="Click to copy · drag to reorder or onto a category">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="Ctx_Copy" />
                        <MenuItem Header="Edit…" Click="Ctx_Edit" />
                        <MenuItem Header="Duplicate" Click="Ctx_Duplicate" />
                        <MenuItem Header="Copy Share Link" Click="Ctx_ShareLink" />
                        <Separator />
                        <MenuItem Header="Pin" Click="Ctx_TogglePin" />
                        <MenuItem Header="Open Link" Click="Ctx_OpenLink"
                                  Visibility="{Binding UrlValue, Converter={StaticResource NotEmptyToVis}}" />
                        <Separator />
                        <MenuItem Header="Delete" Click="Ctx_Delete" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid Margin="14">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                       Foreground="{Binding AccentBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding PinGlyph}" FontFamily="{StaticResource IconFont}"
                                       Foreground="{Binding AccentBrush}" FontSize="11" DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Secondary}"
                                   FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                   MaxHeight="56" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <DockPanel VerticalAlignment="Bottom" LastChildFill="False" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CharCountLabel}" Foreground="{StaticResource Secondary}"
                                   FontSize="10.5" DockPanel.Dock="Left" />
                        <TextBlock x:Name="copyHint" Text="Click to copy" DockPanel.Dock="Right"
                                   Foreground="{Binding AccentBrush}" FontSize="10.5" Opacity="0" />
                    </DockPanel>

                    <!-- "Copied!" overlay, shown briefly after a copy. -->
                    <Border x:Name="copied" CornerRadius="16" Background="{Binding AccentBrush}"
                            Opacity="0" Visibility="Collapsed" Margin="-14">
                        <TextBlock Text="Copied!" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="copyHint" Property="Opacity" Value="0.9" />
                    <Setter TargetName="card" Property="BorderThickness" Value="1.5" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Snippet" InputGestureText="Ctrl+N" Click="NewSnippet_Click" />
                <MenuItem Header="New Category" InputGestureText="Ctrl+Shift+N" Click="NewCategory_Click" />
                <Separator />
                <MenuItem Header="Export Library…" InputGestureText="Ctrl+Shift+E" Click="Menu_Export" />
                <MenuItem Header="Import Library…" Click="Menu_Import" />
                <Separator />
                <MenuItem Header="Settings…" InputGestureText="Ctrl+," Click="Menu_Settings" />
                <Separator />
                <MenuItem Header="Quit Ditto" Click="Menu_Quit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Default Size" Click="Menu_DefaultSize" />
                <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                <Separator />
                <MenuItem Header="Group By">
                    <MenuItem Header="None" Click="Group_None" />
                    <MenuItem Header="Category" Click="Group_Category" />
                    <MenuItem Header="Date Added" Click="Group_Date" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Ditto Help" Click="Menu_Help" />
                <MenuItem Header="About Ditto" Click="Menu_About" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,12,10,6" LastChildFill="False">
                    <TextBlock Text="Ditto" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE8F4;" ToolTip="New Category (Ctrl+Shift+N)"
                            Click="NewCategory_Click" />
                </DockPanel>

                <ListBox x:Name="SidebarList"
                         ItemsSource="{Binding SidebarRows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         AllowDrop="True" DragOver="Sidebar_DragOver" Drop="Sidebar_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Margin" Value="6,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#16000000" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#2A007AFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SidebarRow}">
                            <DockPanel LastChildFill="True" ContextMenuOpening="SidebarCtx_Opening">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit…" Click="SidebarCtx_Edit" />
                                        <MenuItem Header="Duplicate" Click="SidebarCtx_Duplicate" />
                                        <Separator />
                                        <MenuItem Header="Copy Share Link" Click="SidebarCtx_ShareLink" />
                                        <MenuItem Header="Export…" Click="SidebarCtx_Export" />
                                        <Separator />
                                        <MenuItem Header="Delete" Click="SidebarCtx_Delete" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           Foreground="{Binding GlyphBrush}" Width="20"
                                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Secondary}"
                                           DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Secondary}"
                                               Margin="12,10,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Detail ===== -->
        <DockPanel Grid.Column="1" Margin="0">
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Padding="16,10" Background="{StaticResource WindowBackground}">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding DetailTitle}" FontSize="17" FontWeight="Bold"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />

                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE710;" ToolTip="New Snippet (Ctrl+N)" Click="NewSnippet_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE8A3;" ToolTip="Zoom In (Ctrl++)" Click="ZoomIn_Click"
                            IsEnabled="{Binding CanZoomIn}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE71F;" ToolTip="Zoom Out (Ctrl+-)" Click="ZoomOut_Click"
                            IsEnabled="{Binding CanZoomOut}" />
                    <Button x:Name="GroupByButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE8FD;" ToolTip="Group By" Click="GroupBy_Click"
                            Visibility="{Binding IsAllView, Converter={StaticResource BoolToVis}}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="GroupByMenu">
                                <MenuItem Header="None" Click="Group_None" IsCheckable="True" />
                                <MenuItem Header="Category" Click="Group_Category" IsCheckable="True" />
                                <MenuItem Header="Date Added" Click="Group_Date" IsCheckable="True" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border DockPanel.Dock="Right" Background="White" CornerRadius="7" Margin="0,0,12,0"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1" Width="200">
                        <DockPanel Margin="8,0">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                                       DockPanel.Dock="Left" Margin="0,0,6,0" />
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Height="28"
                                     Background="Transparent" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid>
            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="40"
                           Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                           Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyMessage}"
                           Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" />
                <Button Content="New Snippet" Margin="0,14,0,0" Padding="14,7" Click="NewSnippet_Click"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmptyAction, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Grouped card grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SnippetGroup}">
                            <StackPanel Margin="0,0,0,12">
                                <!-- Group header (hidden in ungrouped views) -->
                                <Button Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}"
                                        Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                        Cursor="Hand" Padding="0,4" Margin="0,0,0,8" Click="GroupHeader_Click"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="{Binding IsCollapsed, Converter={StaticResource CollapsedToAngle}}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                   Foreground="{Binding Accent}" Margin="8,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource Secondary}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <ItemsControl ItemsSource="{Binding Snippets}"
                                              ItemTemplate="{StaticResource SnippetCardTemplate}"
                                              Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </DockPanel>
        </Grid>
    </DockPanel>
</Window>
