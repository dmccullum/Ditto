<Window x:Class="Ditto.Views.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category" Height="560" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="80" Padding="10,6" Margin="0,0,8,0" IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Add" MinWidth="80" Padding="10,6" IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="Name" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                           Margin="0,0,0,6" />
                <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1" Padding="8,2">
                    <DockPanel>
                        <TextBlock x:Name="PreviewIcon" Text="&#xE8EC;" FontFamily="{StaticResource IconFont}"
                                   Width="24" VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent" Height="28"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock Text="Color" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                           Margin="0,16,0,6" />
                <ItemsControl x:Name="ColorList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="Icon" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                           Margin="0,16,0,6" />
                <ItemsControl x:Name="IconList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
