<Window x:Class="Ditto.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ditto Settings" Height="280" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="General" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                   Margin="0,0,0,8" />
        <CheckBox x:Name="LaunchAtLogin" Content="Launch Ditto at login"
                  Checked="LaunchAtLogin_Changed" Unchecked="LaunchAtLogin_Changed" />

        <TextBlock Text="Shared Links" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"
                   Margin="0,20,0,8" />
        <DockPanel>
            <TextBlock Text="Imported snippets" VerticalAlignment="Center" DockPanel.Dock="Left"
                       Margin="0,0,12,0" />
            <ComboBox x:Name="LinkBehavior" Width="220" HorizontalAlignment="Left"
                      SelectionChanged="LinkBehavior_Changed" />
        </DockPanel>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{StaticResource Secondary}"
                   Text="When you open a ditto:// link, choose whether to keep the snippet's original category or add it as uncategorized." />
    </StackPanel>
</Window>
