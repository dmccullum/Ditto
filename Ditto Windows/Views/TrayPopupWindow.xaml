<Window x:Class="Ditto.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ditto.ViewModels"
        xmlns:models="clr-namespace:Ditto.Models"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Width="320" SizeToContent="Manual"
        Height="460" Topmost="True" Deactivated="Window_Deactivated"
        FontFamily="Segoe UI">
    <Border Background="White" CornerRadius="10" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <DockPanel>
            <!-- Search -->
            <Border DockPanel.Dock="Top" Padding="10">
                <DockPanel>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                               DockPanel.Dock="Left" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Height="24"
                             TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Hairline}" />

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Padding="10">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" FontFamily="Segoe UI"
                            FontSize="13" Click="OpenMain_Click" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B9;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" />
                            <TextBlock Text="Open Ditto" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7E8;"
                            ToolTip="Quit Ditto" Click="Quit_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Settings" Click="Settings_Click" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Hairline}" />

            <!-- Snippet list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="GroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SnippetGroup}">
                                <StackPanel>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch" Padding="12,8,12,2"
                                            Click="GroupHeader_Click" Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="9" Foreground="{StaticResource Secondary}"
                                                       VerticalAlignment="Center" DockPanel.Dock="Left"
                                                       Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsCollapsed, Converter={StaticResource CollapsedToAngle}}" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}" DockPanel.Dock="Left"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Secondary}" />
                                            <TextBlock Text="{Binding Count}" DockPanel.Dock="Right"
                                                       FontSize="11" Foreground="{StaticResource Secondary}" />
                                        </DockPanel>
                                    </Button>

                                    <ItemsControl ItemsSource="{Binding Snippets}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Snippet}">
                                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch" Padding="12,5"
                                                        Click="Row_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="rb" Background="Transparent" CornerRadius="6"
                                                                    Margin="6,0" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="rb" Property="Background" Value="#14007AFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                   Foreground="{Binding AccentBrush}" Width="20"
                                                                   VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Preview}" FontSize="11"
                                                                       Foreground="{StaticResource Secondary}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyLabel" Text="No snippets yet" Foreground="{StaticResource Secondary}"
                               HorizontalAlignment="Center" Margin="0,30" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
